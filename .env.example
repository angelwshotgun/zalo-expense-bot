# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN ZALO OA EXPENSE BOT
# ==============================================================================

# Cấu hình Server
PORT=3000
NODE_ENV=development

# Zalo Official Account (OA) & Zalo App Configuration
# Lấy tại trang Zalo for Developers: https://developers.zalo.me
ZALO_APP_ID=your_zalo_app_id
ZALO_OA_SECRET_KEY=your_zalo_oa_webhook_secret_key
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token_v3

# Supabase Database Configuration
# Lấy tại Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Bắt buộc sử dụng service_role key để backend bypass RLS khi cần xử lý webhook
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# LLM Providers Configuration
# Chọn provider: "gemini" hoặc "openai" (Mặc định: gemini)
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Model: gemini-2.5-flash)
# Lấy tại Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# OpenAI API Configuration (Nếu dùng gpt-4o-mini thay thế)
OPENAI_API_KEY=sk-...
